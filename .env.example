# ============================================================================
#  Kopia av .env utan hemligheter. Kor sa har:
#      cp .env.example .env
#  och byt ut platshallarna nedan (sarskilt losenord och secret key).
# ============================================================================

# --- Versioner (single source of truth) -------------------------------------
# Utgangslaget ar medvetet ca ett ar gammalt for att kunna testa uppdateringar.
POSTGRES_IMAGE=postgres:17.6
SQLMESH_VERSION=0.227.0
SUPERSET_IMAGE=apache/superset:5.0.0

# --- Projekt ----------------------------------------------------------------
COMPOSE_PROJECT_NAME=pgsqlmesh

# --- Databaser / credentials ------------------------------------------------
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse

SUPERSET_DB=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change-me

# --- Superset ---------------------------------------------------------------
# Slumpad strang, minst 32 tecken. Generera t.ex. med: openssl rand -hex 32
SUPERSET_SECRET_KEY=change-me-please-minst-32-tecken
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# --- Portar -----------------------------------------------------------------
VERSION_MANAGER_PORT=12000
SUPERSET_PORT=12001
